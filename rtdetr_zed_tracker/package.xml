<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtdetr_zed_tracker</name>
  <version>0.0.0</version>
  <description>RT-DETR + ByteTrack + ZED depth 3D object tracking (per-object stable ID, class, distance).</description>
  <maintainer email="a_metehan-tr@hotmail.com">metehan</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>rtdetr_zed_tracker_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-ultralytics</exec_depend>
  <!-- Already used directly by tracker_node.py (yaml) and overlay_node.py (cv2) but were
       missing here; adding explicitly rather than relying on cv_bridge pulling opencv in
       transitively. -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
